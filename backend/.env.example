# Copy to backend/.env and fill in. Never commit the real .env.
# All defaults are local & key-free (whisper + ollama + piper) — you only need
# this file if you want to switch a stage to a cloud provider.

# --- STT (speech-to-text) ---
# STT_PROVIDER=whisper        # "whisper" (default, local, no key) | "deepgram"
# WHISPER_MODEL=base          # "tiny" | "base" (default) | "small" ... (faster <-> better)
# WHISPER_PARTIALS=0          # "1" to emit live captions mid-utterance (costs latency)
# DEEPGRAM_API_KEY=           # required only for STT_PROVIDER=deepgram

# --- LLM (reply generation) ---
# LLM_PROVIDER=ollama         # "ollama" (default, local) | "kimi" | "claude"
# OLLAMA_MODEL=qwen3:0.6b     # any pulled Ollama model (e.g. qwen3:14b for quality)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# MOONSHOT_API_KEY=           # required for LLM_PROVIDER=kimi (Moonshot / Kimi)
# ANTHROPIC_API_KEY=          # required for LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-opus-4-8  # optional override for the Claude model

# --- TTS (speech synthesis of the reply) ---
# TTS_PROVIDER=piper          # "piper" (default, local) | "inworld" (cloud) | "hume"
# PIPER_VOICE=en_US-lessac-medium  # local Piper voice (auto-downloads on first use)
# INWORLD_API_KEY=            # required for TTS_PROVIDER=inworld
# INWORLD_VOICE_ID=Ashley     # optional Inworld voice override
# HUME_API_KEY=               # required for TTS_PROVIDER=hume (not implemented yet)
